<?xml version="1.0" encoding="UTF-8"?>
<!-- Engine data screen for NBT Evo. Placement is the one NBT-AAD uses (car-verified there): a row in the Media/Radio
     list (native state 20), after the Bluetooth audio row (focus 2270). entryButtonFocusID and applicationWeight differ
     from NBT-AAD's (32752 / 200) so both apps can be installed side by side.
     hmiState 10 holds seven labels. Each label is bound to a raDataModel (ids 21..27); libEngineData.so writes the
     text into those models with PluginApp::updateModel. Property ids: 2 = SELECTABLE, 3 = VISIBLE (RHMI property
     table; 2 / 3 / 9 / 10 / 20 / 21 are the ones NBT-AAD's XML uses as well). -->
<pluginApps>
  <pluginApp applicationType="Custom" applicationWeight="210" entryButtonFocusID="32751" insertAfterFocusID="2270" insertStateID="20" text="Dane silnika">
    <comment/>
    <entryButton action="5" id="1" model="3" imageModel="4">
      <properties/>
    </entryButton>
    <actions>
      <hmiAction id="5" target="10"/>
    </actions>
    <models>
      <textIdModel id="3" textId="1">
        <synonyms/>
      </textIdModel>
      <imageIdModel id="4" imageId="56001"/>
      <raDataModel id="21"/>
      <raDataModel id="22"/>
      <raDataModel id="23"/>
      <raDataModel id="24"/>
      <raDataModel id="25"/>
      <raDataModel id="26"/>
      <raDataModel id="27"/>
    </models>
    <hmiStates>
      <hmiState id="10" text="Dane silnika" textModel="3">
        <components>
          <label id="31" model="21">
            <properties>
              <property id="2" value="false"/>
            </properties>
          </label>
          <label id="32" model="22">
            <properties>
              <property id="2" value="false"/>
            </properties>
          </label>
          <label id="33" model="23">
            <properties>
              <property id="2" value="false"/>
            </properties>
          </label>
          <label id="34" model="24">
            <properties>
              <property id="2" value="false"/>
            </properties>
          </label>
          <label id="35" model="25">
            <properties>
              <property id="2" value="false"/>
            </properties>
          </label>
          <label id="36" model="26">
            <properties>
              <property id="2" value="false"/>
            </properties>
          </label>
          <label id="37" model="27">
            <properties>
              <property id="2" value="false"/>
            </properties>
          </label>
        </components>
      </hmiState>
    </hmiStates>
  </pluginApp>
</pluginApps>
